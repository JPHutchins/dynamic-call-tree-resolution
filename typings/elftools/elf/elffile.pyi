from collections.abc import Iterator
from typing import BinaryIO, Literal, overload

from elftools.dwarf.dwarfinfo import DWARFInfo
from elftools.elf.sections import Section
from elftools.elf.segments import Segment

class ELFHeader:
	e_machine: str
	e_ident: dict[str, int]
	@overload
	def __getitem__(self, name: Literal["e_machine", "e_type"]) -> str: ...
	@overload
	def __getitem__(self, name: Literal["e_entry"]) -> int: ...

class ELFFile:
	header: ELFHeader
	elfclass: int
	little_endian: bool
	def __init__(self, stream: BinaryIO) -> None: ...
	def get_section(self, n: int) -> Section | None: ...
	def get_section_by_name(self, name: str) -> Section | None: ...
	def iter_sections(self, type: str | None = None) -> Iterator[Section]: ...
	def iter_segments(self, type: str | None = None) -> Iterator[Segment]: ...
	def has_dwarf_info(self, strict: bool = False) -> bool: ...
	def get_dwarf_info(self, relocate_dwarf_sections: bool = True) -> DWARFInfo: ...
